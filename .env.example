# Copy this file to .env and adjust the values as needed.
# ==============================
# Video & Model
# ==============================
VIDEO_PATH=videos/restaurant-demo.mp4
MODEL_PATH=models/yolo26s-pose.pt

# ==============================
# Inference
# ==============================
CONF=0.40
IOU=0.50
IMGSZ=640

# ==============================
# Logged Count Stabilization
# ==============================
COUNT_INCREASE_DELAY=2.0
COUNT_DECREASE_DELAY=10.0
COUNT_EMPTY_DELAY=10.0
COUNT_HISTORY_SIZE=10

# ==============================
# Output Video
# ==============================
SAVE_OUTPUT_VIDEO=False
OUTPUT_VIDEO_PATH=videos/output/restaurant_analysis_output.mp4

# ==============================
# Video Resizing
# ==============================
RESIZE_VIDEO=False
VIDEO_WIDTH=1280

# ==============================
# Display
# ==============================
SHOW_DASHBOARD=true
DASHBOARD_WIDTH=200
